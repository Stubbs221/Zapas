{
  "manifest_version": 3,
  "name": "Zapas — Chrome",
  "version": "0.3.0",
  "description": "Ручной выбор вкладок, preview и проверка выгрузки/закрытия через локальный Zapas.",
  "minimum_chrome_version": "140",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Открыть подключение Zapas"
  },
  "incognito": "not_allowed",
  "key": ""
}
