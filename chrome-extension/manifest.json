{
  "manifest_version": 3,
  "name": "Zapas — Stage A Chrome Probe",
  "version": "0.1.0",
  "description": "Изолированная техническая проверка вкладок и Native Messaging. Только тестовые действия.",
  "minimum_chrome_version": "140",
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Открыть проверку Zapas"
  },
  "incognito": "not_allowed",
  "key": ""
}
